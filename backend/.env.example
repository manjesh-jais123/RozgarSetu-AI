# Server
PORT=3001
NODE_ENV=development
# For local development: FRONTEND_URL=http://localhost:5173
# For production: set to your Netlify domain, e.g.:
FRONTEND_URL=https://your-netlify-domain.netlify.app
# Comma-separated list of allowed CORS origins (for production)
CORS_ORIGINS=https://your-netlify-domain.netlify.app

# Database
MONGODB_URI=mongodb://localhost:27017/rozgarsetu

# JWT
JWT_SECRET=your-super-secret-jwt-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# ─────────────────────────────────────────────────────────────
# AI / LLM — NEVER expose LLM_API_KEY to the frontend.
# All AI requests must go through the backend.
# ─────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=gpt-4
LLM_PROVIDER=openai
USE_MOCK_LLM=true

# Voice providers use the same LLM_API_KEY / LLM_PROVIDER above.
# For Google Cloud voice, set LLM_PROVIDER=google and provide GOOGLE_API_KEY.
GOOGLE_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
